#!/bin/bash

# This hook validates:
# 1. Conventional commit format (commitlint)
# 2. AI-generated code attribution

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Colors
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Skip validation for merge commits
if echo "$COMMIT_MSG" | grep -q "^Merge"; then
    exit 0
fi

# Skip validation for revert commits
if echo "$COMMIT_MSG" | grep -q "^Revert"; then
    exit 0
fi

# ============================================================================
# STEP 1: Validate commit message format with commitlint
# ============================================================================

echo ""
echo -e "${BLUE}🔍 Validating commit message format...${NC}"

# Check if commitlint is available
if command -v npx &> /dev/null; then
    # Run commitlint on the commit message
    if ! npx commitlint --edit "$COMMIT_MSG_FILE" 2>&1; then
        echo ""
        echo -e "${RED}❌ Commit message does not follow conventional commit format${NC}"
        echo ""
        echo "Required format:"
        echo -e "${GREEN}  type(scope): subject${NC}"
        echo ""
        echo "Examples:"
        echo "  feat(cli): add new command"
        echo "  fix(tests): resolve race condition"
        echo "  docs(readme): update installation steps"
        echo ""
        echo "Allowed types: feat, fix, docs, style, refactor, test, chore, perf, ci, build, revert"
        echo "Allowed scopes: domain, service, repo, cli, logger, classification, deps, release,"
        echo "                lint, security, workflow, config, docs, tests, intents, models,"
        echo "                components, ci"
        echo ""
        echo "See: docs/rules/COMMIT_QUICK_REFERENCE.md"
        exit 1
    fi
    echo -e "${GREEN}✅ Commit message format valid${NC}"
else
    echo -e "${YELLOW}⚠️  commitlint not found - skipping format validation${NC}"
    echo "Run: npm install"
fi

# ============================================================================
# STEP 2: Validate AI attribution (if code files present)
# ============================================================================

# Check if there are code files in the staged changes
STAGED_FILES=$(git diff --cached --name-only)
CODE_FILES=$(echo "$STAGED_FILES" | grep -E '\.(go|js|ts|py|java|c|cpp|rs)$' || true)

# If code files are present, perform AI attribution check
if [ -n "$CODE_FILES" ]; then
    # Check for AI attribution marker
    if echo "$COMMIT_MSG" | grep -q "AI-Generated-By:"; then
        echo ""
        echo -e "${GREEN}✅ AI attribution detected${NC}"

        # Validate format
        if ! echo "$COMMIT_MSG" | grep -q "AI-Generated-By: .* (.*)"; then
            echo ""
            echo -e "${RED}❌ ERROR: AI attribution format incorrect${NC}"
            echo ""
            echo "Expected format:"
            echo "  AI-Generated-By: <Assistant Name> (<Model Version>)"
            echo ""
            echo "Examples:"
            echo "  AI-Generated-By: Avante (Claude 3.5 Sonnet)"
            echo "  AI-Generated-By: Claude (Claude 3.7 Sonnet)"
            echo "  AI-Generated-By: GitHub Copilot (GPT-4)"
            echo ""
            echo "See docs/rules/AI_COMMIT_ATTRIBUTION.md for details"
            exit 1
        fi

        # Check for human review attribution
        if ! echo "$COMMIT_MSG" | grep -q "Reviewed-By:"; then
            echo ""
            echo -e "${YELLOW}⚠️  WARNING: AI-generated code should include 'Reviewed-By:'${NC}"
            echo ""
            echo "Add: Reviewed-By: <Your Name>"
            echo ""
            echo -n "Continue without review attribution? (y/N): "
            read -r response
            if [[ ! "$response" =~ ^[Yy]$ ]]; then
                echo ""
                echo "Commit aborted. Please add 'Reviewed-By:' to your commit message."
                exit 1
            fi
        fi

        echo -e "${GREEN}✅ AI attribution validation passed${NC}"
        echo ""
    else
        # No AI attribution found - remind user
        echo ""
        echo -e "${YELLOW}⚠️  Code files detected without AI attribution${NC}"
        echo ""
        echo "If this code was AI-generated, add attribution:"
        echo ""
        echo -e "${GREEN}  AI-Generated-By: <Assistant> (<Model>)${NC}"
        echo -e "${GREEN}  Reviewed-By: <Your Name>${NC}"
        echo ""
        echo "Examples:"
        echo "  AI-Generated-By: Avante (Claude 3.5 Sonnet)"
        echo "  AI-Generated-By: Claude (Claude 3.7 Sonnet)"
        echo "  AI-Generated-By: GitHub Copilot (GPT-4)"
        echo ""
        echo "See: docs/rules/AI_COMMIT_ATTRIBUTION.md"
        echo ""
        echo -n "Was this code AI-generated? (y/N): "
        read -r response
        if [[ "$response" =~ ^[Yy]$ ]]; then
            echo ""
            echo -e "${RED}❌ Please add AI attribution and commit again${NC}"
            exit 1
        else
            echo ""
            echo -e "${GREEN}✅ Proceeding with human-written code commit${NC}"
            echo ""
        fi
    fi
fi

exit 0

