#!/bin/bash

# Pre-commit Hook - Fast Code Quality Checks
#
# This hook enforces checks that MATCH CI to catch failures early:
# 1. Session active check (warning only)
# 2. No generated files
# 3. No forbidden comment markers (TODO, FIXME, etc.)
# 4. No debug statements
# 5. No secrets
# 6. Code formatting (gofmt)
# 7. Build success
# 8. Static analysis - go vet
# 9. Staticcheck - catches unused code, simplifications (MATCHES CI)
# 10. Fixture usage check - noinlinecareer analyzer
# 11. Golangci-lint on changed packages (full lint, MATCHES CI)
# 12. Intent architecture check (MATCHES CI)
# 13. Localized tests - tests ONLY for changed packages (fast)
# 14. TDD compliance check
# 15. Strict pattern checks
# 16. Documentation check - validate-documentation.sh + docblocks analyzer
#
# Full test suite runs in CI as regression check.
# Run 'make test' locally for full regression testing before major changes.

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "🔍 PRE-COMMIT CHECKS"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

# Check if this is documentation-only changes
STAGED_FILES=$(git diff --cached --name-only)
DOCS_ONLY=true
for file in $STAGED_FILES; do
    # Check if file is NOT documentation
    if [[ ! "$file" =~ ^docs/ ]] && [[ ! "$file" =~ ^tasks/ ]] && [[ ! "$file" =~ \.md$ ]]; then
        DOCS_ONLY=false
        break
    fi
done

if [ "$DOCS_ONLY" = true ]; then
    echo -e "${BLUE}📝 Documentation-only commit detected${NC}"
    echo -e "${BLUE}ℹ️  Skipping build and test checks${NC}"
    echo ""

    # Still check for secrets in documentation
    SECRET_PATTERNS='password["\s]*[:=]|secret["\s]*[:=]|api[_-]?key["\s]*[:=]|token["\s]*[:=]'
    if git diff --cached | grep -iE "$SECRET_PATTERNS" | grep -v 'password_hash' > /dev/null 2>&1; then
        echo -e "${RED}❌ ERROR: Potential secrets detected${NC}"
        echo ""
        echo "DO NOT commit secrets! Use environment variables."
        exit 1
    fi

    echo ""
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${GREEN}✅ Documentation checks passed${NC}"
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    exit 0
fi

# Check for generated files
echo "Checking for generated files..."
GENERATED_FILES=$(git diff --cached --name-only | grep -E '\.(out|exe|dll|so|dylib|test)$' || true)
if [ -n "$GENERATED_FILES" ]; then
    echo -e "${RED}❌ ERROR: Generated files in staging${NC}"
    echo ""
    echo "$GENERATED_FILES"
    echo ""
    echo "Remove with: git reset <filename>"
    exit 1
fi

# Check for coverage files
COVERAGE_FILES=$(git diff --cached --name-only | grep -E 'coverage\.(out|html)' || true)
if [ -n "$COVERAGE_FILES" ]; then
    echo -e "${RED}❌ ERROR: Coverage files in staging${NC}"
    echo ""
    echo "$COVERAGE_FILES"
    echo ""
    echo "Remove with: git reset coverage.out coverage.html"
    exit 1
fi

# Check for forbidden comment markers (only in added lines)
# Skip check for AGENTS.md and .git-hooks/pre-commit as they document the rules
FORBIDDEN_MARKERS="TO""DO|FIX""ME|XX""X|HA""CK|\bNO""TE\b|\bIMPOR""TANT\b|\bBU""G\b"

# Get list of staged Go files (excluding test files)
STAGED_GO=$(git diff --cached --name-only | grep '\.go$' | grep -v '_test.go' || true)

if [ -n "$STAGED_GO" ]; then
    for file in $STAGED_GO; do
        # Skip documentation files
        if [[ "$file" == "AGENTS.md" ]] || [[ "$file" == ".git-hooks/pre-commit" ]]; then
            continue
        fi

        # Check for forbidden markers in STAGED content of this file only
        STAGED_CONTENT=$(git diff --cached -- "$file" | grep '^+' | grep -v '^+++' || true)
        if echo "$STAGED_CONTENT" | grep -E "$FORBIDDEN_MARKERS" > /dev/null 2>&1; then
            echo -e "${RED}❌ ERROR: Forbidden comment markers detected in $file${NC}"
            echo ""
            echo "Found: forbidden comment markers (TODO, FIXME, XXX, HACK, etc.)"
            echo ""
            echo "$STAGED_CONTENT" | grep -E "$FORBIDDEN_MARKERS" | head -3
            echo ""
            echo "Action: Complete the work, create an issue, or refactor the code"
            echo "See: Comment Rules in AGENTS.md"
            exit 1
        fi
    done
fi

# Check for debug statements (only in added lines)
DEBUG_PATTERNS='fmt\.Println\("DEBUG'
if git diff --cached | grep '^+' | grep -v '^+++' | grep -E "$DEBUG_PATTERNS" > /dev/null 2>&1; then
    echo -e "${YELLOW}⚠️  WARNING: Debug statements found${NC}"
    git diff --cached | grep '^+' | grep -v '^+++' | grep -E "$DEBUG_PATTERNS" | head -3
    echo ""
fi

# Check for secrets (only in added lines)
SECRET_PATTERNS='password["\s]*[:=]|secret["\s]*[:=]|api[_-]?key["\s]*[:=]|token["\s]*[:=]'
if git diff --cached | grep '^+' | grep -v '^+++' | grep -iE "$SECRET_PATTERNS" | grep -v 'password_hash' > /dev/null 2>&1; then
    echo -e "${RED}❌ ERROR: Potential secrets detected${NC}"
    echo ""
    echo "DO NOT commit secrets! Use environment variables."
    exit 1
fi

# Format check
echo "Checking code formatting..."
UNFORMATTED=$(gofmt -l . 2>&1 | grep -v '^vendor/' | grep '\.go$' || true)
if [ -n "$UNFORMATTED" ]; then
    echo -e "${RED}❌ ERROR: Code not formatted${NC}"
    echo ""
    echo "Run: go fmt ./..."
    exit 1
fi

# Build check
echo "Building project..."
if ! go build ./... > /dev/null 2>&1; then
    echo -e "${RED}❌ ERROR: Build failed${NC}"
    go build ./...
    exit 1
fi

# Static analysis (go vet) - quick check
echo "Running go vet..."
if ! go vet ./... > /dev/null 2>&1; then
    echo -e "${RED}❌ ERROR: go vet failed${NC}"
    go vet ./...
    exit 1
fi

# Staticcheck - catches unused code, simplifications, etc.
# This is run in CI and was missing from pre-commit, causing CI failures
if command -v staticcheck > /dev/null 2>&1; then
    CHANGED_GO_FILES=$(git diff --cached --name-only | grep '\.go$' || true)
    if [ -n "$CHANGED_GO_FILES" ]; then
        echo "Running staticcheck on changed packages..."
        ALL_PACKAGES=$(echo "$CHANGED_GO_FILES" | xargs -I{} dirname {} | sort -u | sed 's|^|./|' | sed 's|$|/...|')
        CHANGED_PACKAGES=""
        for pkg in $ALL_PACKAGES; do
            pkg_dir=$(echo "$pkg" | sed 's|/\.\.\.$||' | sed 's|^\./||')
            if [ -d "$pkg_dir" ]; then
                CHANGED_PACKAGES="$CHANGED_PACKAGES $pkg"
            fi
        done
        if [ -z "$CHANGED_PACKAGES" ]; then
            echo -e "${GREEN}✅ staticcheck passed (no existing packages to check)${NC}"
        elif ! staticcheck $CHANGED_PACKAGES > /dev/null 2>&1; then
            echo -e "${RED}❌ ERROR: staticcheck found issues${NC}"
            echo ""
            staticcheck $CHANGED_PACKAGES 2>&1 | head -20
            echo ""
            echo "Fix staticcheck issues before committing."
            exit 1
        fi
        echo -e "${GREEN}✅ staticcheck passed${NC}"
    fi
else
    echo -e "${YELLOW}⚠️  staticcheck not found, skipping${NC}"
    echo "   Install: go install honnef.co/go/tools/cmd/staticcheck@latest"
fi

# Fixture usage check (uses cached binary - fast)
echo "Checking fixture usage..."
if ! make check-fixtures > /dev/null 2>&1; then
    echo -e "${RED}❌ ERROR: Fixture usage violations found${NC}"
    echo ""
    echo "Test files must use fixture factories from internal/testutil/fixtures/"
    echo "instead of inline career.* struct literals."
    echo ""
    make check-fixtures 2>&1 | grep "inline career" | head -5
    echo ""
    echo "Fix by using fixtures.NewEvent(), fixtures.NewBurst(), etc."
    exit 1
fi
echo -e "${GREEN}✅ Fixture usage check passed${NC}"

# Golangci-lint on changed packages (catches depguard, lll, nilnil, unused, etc.)
# NOTE: We run WITHOUT --new-from-rev to catch issues like unused code that becomes
# dead due to changes elsewhere in the file. This matches CI behavior.
if command -v golangci-lint > /dev/null 2>&1; then
    CHANGED_GO_FILES=$(git diff --cached --name-only | grep '\.go$' || true)
    if [ -n "$CHANGED_GO_FILES" ]; then
        echo "Running golangci-lint on changed packages..."
        # Build array of package paths safely to prevent shell injection.
        # Directory names from git could theoretically contain shell metacharacters,
        # so we use a bash array and proper quoting instead of unquoted expansion.
        CHANGED_PACKAGES=()
        while IFS= read -r dir; do
            if [ -d "$dir" ]; then
                CHANGED_PACKAGES+=("./$dir/...")
            fi
        done < <(echo "$CHANGED_GO_FILES" | xargs -I{} dirname {} | sort -u)

        if [ ${#CHANGED_PACKAGES[@]} -eq 0 ]; then
            echo -e "${GREEN}✅ golangci-lint skipped (only deleted packages)${NC}"
        else
            # Use array expansion with quotes to safely pass arguments
            LINT_OUTPUT=$(golangci-lint run --timeout=5m --new-from-rev=HEAD "${CHANGED_PACKAGES[@]}" 2>&1)
            LINT_EXIT=$?
            # Exit code 1 = lint issues found; other non-zero = internal errors (e.g., deleted dirs in diff)
            if [ $LINT_EXIT -eq 1 ]; then
                echo -e "${RED}❌ ERROR: golangci-lint found issues${NC}"
                echo ""
                echo "$LINT_OUTPUT" | head -20
                echo ""
                echo "Fix lint issues before committing."
                exit 1
            elif [ $LINT_EXIT -gt 1 ]; then
                echo -e "${YELLOW}⚠️  golangci-lint internal error (exit code $LINT_EXIT)${NC}"
                echo "   This may be due to deleted files or config issues."
                echo "   Output: $(echo "$LINT_OUTPUT" | head -3)"
            fi
        fi
        echo -e "${GREEN}✅ golangci-lint passed${NC}"
    fi
else
    echo -e "${YELLOW}⚠️  golangci-lint not found, skipping lint check${NC}"
    echo "   Install: go install github.com/golangci/golangci-lint/cmd/golangci-lint@latest"
fi

# Intent architecture check - catches architecture violations early
# This is run in CI and is fast enough (~1.5s) for pre-commit
if [ -f "scripts/check-intent-architecture.sh" ]; then
    CHANGED_INTENT_FILES=$(git diff --cached --name-only | grep -E 'internal/tui/intents/|internal/tui/views/' || true)
    if [ -n "$CHANGED_INTENT_FILES" ]; then
        echo "Running intent architecture check..."
        if ! bash scripts/check-intent-architecture.sh > /dev/null 2>&1; then
            echo -e "${RED}❌ ERROR: Intent architecture violations found${NC}"
            echo ""
            bash scripts/check-intent-architecture.sh 2>&1 | grep -E "❌|VIOLATION" | head -10
            echo ""
            echo "Run 'make check-intent-architecture' for full details."
            exit 1
        fi
        echo -e "${GREEN}✅ Intent architecture check passed${NC}"
    fi
fi

# Localized tests - run tests ONLY for changed packages (fast)
# Full test suite is run in CI as regression check
if [ "$SKIP_TESTS" != "1" ]; then
    CHANGED_GO_FILES=$(git diff --cached --diff-filter=ACMT --name-only | grep '\.go$' || true)
    if [ -n "$CHANGED_GO_FILES" ]; then
        echo "Running localized tests for changed packages..."
        CHANGED_PACKAGES=$(echo "$CHANGED_GO_FILES" | xargs -I{} dirname {} | sort -u | sed 's|^|./|' | sed 's|$|/...|')

        # Filter to only packages that have test files
        TESTABLE_PACKAGES=""
        for pkg in $CHANGED_PACKAGES; do
            # Remove the /... suffix to get the directory
            pkg_dir=$(echo "$pkg" | sed 's|/\.\.\.$||' | sed 's|^\./||')
            # Skip test infrastructure packages (features/, internal/testutil)
            if [[ "$pkg_dir" == features/* ]] || [[ "$pkg_dir" == *"/testutil"* ]]; then
                continue
            fi
            if ls "$pkg_dir"/*_test.go > /dev/null 2>&1; then
                TESTABLE_PACKAGES="$TESTABLE_PACKAGES $pkg"
            fi
        done

        if [ -n "$TESTABLE_PACKAGES" ]; then
            if ! go test -count=1 -short $TESTABLE_PACKAGES > /dev/null 2>&1; then
                echo -e "${RED}❌ ERROR: Tests failed for changed packages${NC}"
                echo ""
                go test -count=1 -short $TESTABLE_PACKAGES 2>&1 | grep -E "FAIL|Error|panic" | head -20
                echo ""
                echo "Fix failing tests before committing."
                echo "To skip: SKIP_TESTS=1 git commit"
                exit 1
            fi
            echo -e "${GREEN}✅ Localized tests passed${NC}"

            # Coverage check - 95% per-package requirement for packages with logic changes
            if [ "$SKIP_COVERAGE_CHECK" != "1" ]; then
                echo "Checking coverage for modified packages (>= 95% required)..."
                # Filter to packages with actual logic changes (not just import renames)
                LOGIC_PACKAGES=""
                for pkg in $TESTABLE_PACKAGES; do
                    pkg_dir=$(echo "$pkg" | sed 's|/\.\.\.$||' | sed 's|^\./||')
                    PKG_FILES=$(git diff --cached --diff-filter=ACMT --name-only -- "$pkg_dir" | grep '\.go$' | grep -v '_test\.go$' || true)
                    HAS_LOGIC=false
                    for file in $PKG_FILES; do
                        DIFF_LINES=$(git diff --cached -- "$file" | grep '^[+-]' | grep -v '^[+-]\{3\}' || true)
                        FILE_LOGIC=$(echo "$DIFF_LINES" | grep -v '^\s*$' | grep -vE '^[+-]\s*"[^"]*"\s*$' | grep -vE '^[+-]\s*import\s' | grep -vE '^[+-]\s*\)\s*$' | grep -vE '^[+-]\s*\(\s*$' | grep -vE '^[+-]\s*$' || true)
                        if [ -n "$FILE_LOGIC" ]; then
                            HAS_LOGIC=true
                            break
                        fi
                    done
                    if [ "$HAS_LOGIC" = true ]; then
                        LOGIC_PACKAGES="$LOGIC_PACKAGES $pkg"
                    fi
                done

                COVERAGE_FAILED=""
                COVERAGE_PREEXISTING=""
                for pkg in $LOGIC_PACKAGES; do
                    COVERAGE_OUTPUT=$(go test -cover "$pkg" 2>/dev/null | grep "coverage:" || echo "")
                    if [ -n "$COVERAGE_OUTPUT" ]; then
                        COVERAGE_PCT=$(echo "$COVERAGE_OUTPUT" | grep -oP 'coverage: \K[0-9.]+' || echo "0")
                        COVERAGE_INT=$(printf "%.0f" "$COVERAGE_PCT" 2>/dev/null || echo "0")

                        if [ "$COVERAGE_INT" -gt 0 ] && [ "$COVERAGE_INT" -lt 95 ]; then
                            git stash push --quiet 2>/dev/null
                            BASELINE_OUTPUT=$(go test -count=1 -cover "$pkg" 2>/dev/null | grep "coverage:" || echo "")
                            BASELINE_PCT=$(echo "$BASELINE_OUTPUT" | grep -oP 'coverage: \K[0-9.]+' || echo "0")
                            BASELINE_INT=$(printf "%.0f" "$BASELINE_PCT" 2>/dev/null || echo "0")
                            git stash pop --index --quiet 2>/dev/null

                            if [ "$BASELINE_INT" -lt 95 ]; then
                                CURRENT_X10=$(echo "$COVERAGE_PCT" | awk '{printf "%.0f", $1 * 10}')
                                BASELINE_X10=$(echo "$BASELINE_PCT" | awk '{printf "%.0f", $1 * 10}')
                                if [ "$CURRENT_X10" -ge "$BASELINE_X10" ]; then
                                    COVERAGE_PREEXISTING="$COVERAGE_PREEXISTING\n  $pkg: ${COVERAGE_PCT}% (baseline: ${BASELINE_PCT}%, pre-existing)"
                                else
                                    COVERAGE_FAILED="$COVERAGE_FAILED\n  $pkg: ${COVERAGE_PCT}% (was ${BASELINE_PCT}%, regression!)"
                                fi
                            else
                                COVERAGE_FAILED="$COVERAGE_FAILED\n  $pkg: ${COVERAGE_PCT}% (was ${BASELINE_PCT}%, dropped below 95%!)"
                            fi
                        fi
                    fi
                done

                if [ -n "$COVERAGE_PREEXISTING" ]; then
                    echo -e "${YELLOW}⚠️  Pre-existing coverage gaps (not blocking):${NC}"
                    echo -e "$COVERAGE_PREEXISTING"
                    echo ""
                fi

                if [ -n "$COVERAGE_FAILED" ]; then
                    echo -e "${RED}❌ ERROR: Coverage regression detected${NC}"
                    echo ""
                    echo -e "Packages with regressions:$COVERAGE_FAILED"
                    echo ""
                    echo "Your changes decreased coverage or dropped it below 95%."
                    echo "Add tests to restore coverage before committing."
                    echo "Check coverage: go test -cover ./path/to/package/..."
                    echo ""
                    echo "To skip: SKIP_COVERAGE_CHECK=1 git commit"
                    exit 1
                fi
                echo -e "${GREEN}✅ Coverage check passed (>= 95% per package or no regression)${NC}"
            else
                echo -e "${YELLOW}⚠️  Coverage check skipped (SKIP_COVERAGE_CHECK=1)${NC}"
            fi
        fi
    fi
else
    echo -e "${YELLOW}⚠️  Tests skipped (SKIP_TESTS=1)${NC}"
fi

# Full test suite is run in CI as regression check
echo -e "${BLUE}ℹ️  Full test suite runs in CI. Run 'make test' locally for regression check.${NC}"

# TDD check (can be overridden)
if [ "$SKIP_TDD_CHECK" != "1" ]; then
    echo "Checking TDD compliance..."
    if bash scripts/tdd-check.sh; then
        echo -e "${GREEN}✅ TDD check passed${NC}"
    else
        TDD_EXIT_CODE=$?
        if [ $TDD_EXIT_CODE -eq 10 ]; then
            # Warning only - allow commit but inform user
            echo ""
            echo -e "${YELLOW}⚠️  To skip TDD check: SKIP_TDD_CHECK=1 git commit${NC}"
            echo ""
            # Don't block commit for TDD warnings
        else
            # Other error - block commit
            exit $TDD_EXIT_CODE
        fi
    fi
else
    echo -e "${YELLOW}⚠️  TDD check skipped (SKIP_TDD_CHECK=1)${NC}"
fi

# Strict pattern check for Go files (can be overridden)
if [ "$SKIP_PATTERN_CHECK" != "1" ]; then
    if [ -f "scripts/check-patterns-strict.sh" ]; then
        STAGED_GO=$(git diff --cached --name-only | grep '\.go$' || true)
        if [ -n "$STAGED_GO" ]; then
            echo "Running strict pattern checks..."
            if ! bash scripts/check-patterns-strict.sh 2>/dev/null; then
                echo -e "${RED}❌ ERROR: Pattern violations found${NC}"
                echo ""
                echo "Run 'make check-patterns' for details."
                echo "To skip: SKIP_PATTERN_CHECK=1 git commit"
                exit 1
            fi
        fi
    fi
fi

# Documentation check (doc.go files and function documentation) - REQUIRED
if [ "$SKIP_DOC_CHECK" != "1" ]; then
    echo "Running documentation check..."
    STAGED_GO=$(git diff --cached --name-only | grep '\.go$' | grep -v '_test.go' || true)
    
    # Exclude renames and filter out files with import-only changes
    CONTENT_GO=$(git diff --cached --diff-filter=ACMT --name-only | grep '\.go$' | grep -v '_test.go' || true)
    LOGIC_GO=""
    for file in $CONTENT_GO; do
        DIFF_LINES=$(git diff --cached -- "$file" | grep '^[+-]' | grep -v '^[+-]\{3\}' || true)
        HAS_LOGIC=$(echo "$DIFF_LINES" | grep -v '^\s*$' | grep -vE '^[+-]\s*"[^"]*"\s*$' | grep -vE '^[+-]\s*import\s' | grep -vE '^[+-]\s*\)\s*$' | grep -vE '^[+-]\s*\(\s*$' | grep -vE '^[+-]\s*$' || true)
        if [[ -n "$HAS_LOGIC" ]]; then
            LOGIC_GO="$LOGIC_GO $file"
        fi
    done
    LOGIC_GO=$(echo "$LOGIC_GO" | xargs)
    
    if [ -n "$LOGIC_GO" ]; then
        # Step 1: Run validate-documentation.sh for basic checks (doc.go, inline comments)
        if [ -f "scripts/validate-documentation.sh" ]; then
            echo "Validating documentation structure..."
            if ! bash scripts/validate-documentation.sh --verbose 2>/dev/null; then
                echo -e "${RED}❌ ERROR: Documentation violations found${NC}"
                echo ""
                echo "Documentation required for all exported symbols:"
                echo "  - Package doc.go file with package-level documentation"
                echo "  - Type: Godoc comment starting with type name"
                echo "  - No inline comments (except in e2e test files)"
                echo ""
                echo "Run 'scripts/validate-documentation.sh --fix' to attempt automatic fixes."
                echo ""
                echo "To skip: SKIP_DOC_CHECK=1 git commit"
                exit 1
            fi
        fi

        # Step 2: ALWAYS run docblocks analyzer for structured sections (Expected/Returns/Side effects)
        # This is the authoritative check - validate-documentation.sh is a lighter pre-check
        if [ ! -f "./bin/docblocks" ]; then
            echo "Building docblocks analyzer..."
            go build -o ./bin/docblocks ./cmd/docblocks > /dev/null 2>&1
        fi

        # Run docblocks analyzer on staged packages (filter out deleted directories)
         ALL_STAGED_PACKAGES=$(echo "$LOGIC_GO" | tr ' ' '\n' | xargs -I{} dirname {} | sort -u | sed 's|^|./|' | sed 's|$|/...|')
         STAGED_PACKAGES=""
         for pkg in $ALL_STAGED_PACKAGES; do
             pkg_dir=$(echo "$pkg" | sed 's|/\.\.\.$||' | sed 's|^\./||')
             # Skip mock packages
             if [[ "$pkg_dir" == *"/mocks/"* ]] || [[ "$pkg_dir" == *"/mocks" ]]; then
                 continue
             fi
             # Skip test infrastructure
             if [[ "$pkg_dir" == *"/testutil"* ]] || [[ "$pkg_dir" == *"/testutil/"* ]]; then
                 continue
             fi
             # Skip BDD test infrastructure
             if [[ "$pkg_dir" == features* ]]; then
                 continue
             fi
             if [ -d "$pkg_dir" ]; then
                 STAGED_PACKAGES="$STAGED_PACKAGES $pkg"
             fi
         done
        if [ -n "$STAGED_PACKAGES" ]; then
            echo "Checking docblock sections (Expected/Returns/Side effects)..."
            if ! go vet -vettool=./bin/docblocks $STAGED_PACKAGES 2>/dev/null; then
                echo -e "${RED}❌ ERROR: Docblock section violations found${NC}"
                echo ""
                # Show the actual errors
                go vet -vettool=./bin/docblocks $STAGED_PACKAGES 2>&1 | grep -v "^#" | head -10
                echo ""
                echo "Documentation required for all exported functions/methods:"
                echo "  - Expected: section (if function has parameters)"
                echo "  - Returns: section (if function returns values)"
                echo "  - Side effects: section (always required)"
                echo ""
                echo "Run 'make check-docblocks' for full details."
                echo "Run 'scripts/fix-doc-blocks.sh <file>' to attempt automatic fixes."
                echo ""
                echo "To skip: SKIP_DOC_CHECK=1 git commit"
                exit 1
            fi
        else
            echo -e "${GREEN}✅ Docblock check skipped (no production packages to check)${NC}"
        fi
    fi
    echo -e "${GREEN}✅ Documentation check passed${NC}"
else
    echo -e "${YELLOW}⚠️  Documentation check skipped (SKIP_DOC_CHECK=1)${NC}"
fi

echo ""
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}✅ All pre-commit checks passed${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

exit 0
