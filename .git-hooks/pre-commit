#!/bin/bash

# Pre-commit Hook - Fast Code Quality Checks
#
# This hook enforces FAST checks only:
# 1. Session active check
# 2. No generated files
# 3. No debug statements
# 4. No secrets
# 5. Code formatting (Go files only)
# 6. Build success (Go files only)
# 7. Static analysis - go vet (Go files only)
# 8. Golangci-lint on changed packages (Go files only)
# 9. TDD compliance check (Go files only)
# 10. Strict pattern checks (Go files only)
#
# Full test suite and race detection should be run via:
#   make check-compliance
# before committing. Pre-commit focuses on fast checks only.

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "🔍 PRE-COMMIT CHECKS"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

# Session check (warn only, don't block)
if [ ! -f ".session-active" ]; then
    echo -e "${YELLOW}⚠️  No active session. Run 'make session-start' for full workflow.${NC}"
    echo ""
fi

# Check if this is documentation-only changes
STAGED_FILES=$(git diff --cached --name-only)
DOCS_ONLY=true
for file in $STAGED_FILES; do
    # Check if file is NOT documentation
    if [[ ! "$file" =~ ^docs/ ]] && [[ ! "$file" =~ ^tasks/ ]] && [[ ! "$file" =~ \.md$ ]]; then
        DOCS_ONLY=false
        break
    fi
done

if [ "$DOCS_ONLY" = true ]; then
    echo -e "${BLUE}📝 Documentation-only commit detected${NC}"
    echo -e "${BLUE}ℹ️  Skipping build and test checks${NC}"
    echo ""
    
    # Still check for secrets in documentation
    SECRET_PATTERNS='password["\s]*[:=]|secret["\s]*[:=]|api[_-]?key["\s]*[:=]|token["\s]*[:=]'
    if git diff --cached | grep -iE "$SECRET_PATTERNS" | grep -v 'password_hash' > /dev/null 2>&1; then
        echo -e "${RED}❌ ERROR: Potential secrets detected${NC}"
        echo ""
        echo "DO NOT commit secrets! Use environment variables."
        exit 1
    fi
    
    echo ""
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${GREEN}✅ Documentation checks passed${NC}"
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    exit 0
fi

# Check for generated files
echo "Checking for generated files..."
GENERATED_FILES=$(git diff --cached --name-only | grep -E '\.(out|exe|dll|so|dylib|test)$' || true)
if [ -n "$GENERATED_FILES" ]; then
    echo -e "${RED}❌ ERROR: Generated files in staging${NC}"
    echo ""
    echo "$GENERATED_FILES"
    echo ""
    echo "Remove with: git reset <filename>"
    exit 1
fi

# Check for coverage files
COVERAGE_FILES=$(git diff --cached --name-only | grep -E 'coverage\.(out|html)' || true)
if [ -n "$COVERAGE_FILES" ]; then
    echo -e "${RED}❌ ERROR: Coverage files in staging${NC}"
    echo ""
    echo "$COVERAGE_FILES"
    echo ""
    echo "Remove with: git reset coverage.out coverage.html"
    exit 1
fi

# Check for forbidden comment markers (only in added lines)
# Variable is split to avoid self-matching during diff checks
FORBIDDEN_MARKERS="TO""DO|FIX""ME|XX""X|HA""CK|NO""TE:|IMPOR""TANT:|\bBU""G\b"
if git diff --cached | grep '^+' | grep -v '^+++' | grep -E "$FORBIDDEN_MARKERS" | grep -v '_test.go' > /dev/null 2>&1; then
    echo -e "${RED}❌ ERROR: Forbidden comment markers detected${NC}"
    echo ""
    echo "Found: TODO, FIXME, XXX, HACK, NOTE, IMPORTANT, or BUG"
    echo ""
    git diff --cached | grep '^+' | grep -v '^+++' | grep -E "$FORBIDDEN_MARKERS" | grep -v '_test.go' | head -5
    echo ""
    echo "Action: Complete the work, create an issue, or refactor the code"
    echo "See: Comment Rules in AGENTS.md"
    exit 1
fi

# Check for debug statements (only in added lines)
DEBUG_PATTERNS='fmt\.Println\("DEBUG'
if git diff --cached | grep '^+' | grep -v '^+++' | grep -E "$DEBUG_PATTERNS" > /dev/null 2>&1; then
    echo -e "${YELLOW}⚠️  WARNING: Debug statements found${NC}"
    git diff --cached | grep '^+' | grep -v '^+++' | grep -E "$DEBUG_PATTERNS" | head -3
    echo ""
fi

# Check for secrets (only in added lines)
SECRET_PATTERNS='password["\s]*[:=]|secret["\s]*[:=]|api[_-]?key["\s]*[:=]|token["\s]*[:=]'
if git diff --cached | grep '^+' | grep -v '^+++' | grep -iE "$SECRET_PATTERNS" | grep -v 'password_hash' > /dev/null 2>&1; then
    echo -e "${RED}❌ ERROR: Potential secrets detected${NC}"
    echo ""
    echo "DO NOT commit secrets! Use environment variables."
    exit 1
fi

# Format check
echo "Checking code formatting..."
UNFORMATTED=$(gofmt -l . 2>&1 | grep -v '^vendor/' | grep '\.go$' || true)
if [ -n "$UNFORMATTED" ]; then
    echo -e "${RED}❌ ERROR: Code not formatted${NC}"
    echo ""
    echo "Run: go fmt ./..."
    exit 1
fi

# Build check
echo "Building project..."
if ! go build ./... > /dev/null 2>&1; then
    echo -e "${RED}❌ ERROR: Build failed${NC}"
    go build ./...
    exit 1
fi

# Static analysis (go vet) - quick check
echo "Running go vet..."
if ! go vet ./... > /dev/null 2>&1; then
    echo -e "${RED}❌ ERROR: go vet failed${NC}"
    go vet ./...
    exit 1
fi

# Golangci-lint on changed packages (catches depguard, lll, nilnil, etc.)
if command -v golangci-lint > /dev/null 2>&1; then
    CHANGED_GO_FILES=$(git diff --cached --name-only | grep '\.go$' || true)
    if [ -n "$CHANGED_GO_FILES" ]; then
        echo "Running golangci-lint on changed packages..."
        CHANGED_PACKAGES=$(echo "$CHANGED_GO_FILES" | xargs -I{} dirname {} | sort -u | sed 's|^|./|' | sed 's|$|/...|')
        if ! golangci-lint run --timeout=5m --new-from-rev=HEAD $CHANGED_PACKAGES > /dev/null 2>&1; then
            echo -e "${RED}❌ ERROR: golangci-lint found issues${NC}"
            echo ""
            golangci-lint run --timeout=5m --new-from-rev=HEAD $CHANGED_PACKAGES 2>&1 | head -20
            echo ""
            echo "Fix lint issues before committing."
            exit 1
        fi
        echo -e "${GREEN}✅ golangci-lint passed${NC}"
    fi
else
    echo -e "${YELLOW}⚠️  golangci-lint not found, skipping lint check${NC}"
    echo "   Install: go install github.com/golangci/golangci-lint/cmd/golangci-lint@latest"
fi

# Full test suite and race detection are not run in pre-commit.
# Run 'make check-compliance' before committing to ensure tests pass.
echo -e "${BLUE}ℹ️  Run 'make check-compliance' before committing to ensure tests pass${NC}"

# TDD check (can be overridden)
if [ "$SKIP_TDD_CHECK" != "1" ]; then
    echo "Checking TDD compliance..."
    if bash scripts/tdd-check.sh; then
        echo -e "${GREEN}✅ TDD check passed${NC}"
    else
        TDD_EXIT_CODE=$?
        if [ $TDD_EXIT_CODE -eq 10 ]; then
            # Warning only - allow commit but inform user
            echo ""
            echo -e "${YELLOW}⚠️  To skip TDD check: SKIP_TDD_CHECK=1 git commit${NC}"
            echo ""
            # Don't block commit for TDD warnings
        else
            # Other error - block commit
            exit $TDD_EXIT_CODE
        fi
    fi
else
    echo -e "${YELLOW}⚠️  TDD check skipped (SKIP_TDD_CHECK=1)${NC}"
fi

# Strict pattern check for Go files (can be overridden)
if [ "$SKIP_PATTERN_CHECK" != "1" ]; then
    if [ -f "scripts/check-patterns-strict.sh" ]; then
        STAGED_GO=$(git diff --cached --name-only | grep '\.go$' || true)
        if [ -n "$STAGED_GO" ]; then
            echo "Running strict pattern checks..."
            if ! bash scripts/check-patterns-strict.sh 2>/dev/null; then
                echo -e "${YELLOW}⚠️  Pattern violations found. Run 'make check-patterns' for details.${NC}"
                # Don't block - just warn
            fi
        fi
    fi
fi

echo ""
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}✅ All pre-commit checks passed${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

exit 0
