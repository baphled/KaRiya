{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [
      2,
      "always",
      [
        "feat",
        "fix",
        "docs",
        "style",
        "refactor",
        "test",
        "chore",
        "perf",
        "ci",
        "build",
        "revert"
      ]
    ],
    "type-case": [2, "always", "lower-case"],
    "type-empty": [2, "never"],
    "scope-enum": [
      2,
      "always",
      [
        "agents",
        "app",
        "arch",
        "bdd",
        "behaviors",
        "bursts",
        "classification",
        "ci",
        "cli",
        "commands",
        "components",
        "config",
        "cv",
        "demo",
        "demos",
        "deps",
        "docs",
        "domain",
        "e2e",
        "events",
        "facts",
        "generatecv",
        "git",
        "guides",
        "intents",
        "lint",
        "logger",
        "models",
        "navigation",
        "release",
        "repo",
        "rules",
        "screens",
        "security",
        "service",
        "skills",
        "summary",
        "tasks",
        "test",
        "testing",
        "tests",
        "tui",
        "uikit",
        "workflow",
        "workflows"
      ]
    ],
    "scope-case": [2, "always", "lower-case"],
    "subject-empty": [2, "never"],
    "subject-case": [2, "never"],
    "subject-full-stop": [2, "never", "."],
    "subject-max-length": [2, "always", 72],
    "header-max-length": [2, "always", 100],
    "body-leading-blank": [2, "always"],
    "body-max-line-length": [2, "always", 100],
    "footer-leading-blank": [2, "always"],
    "footer-max-line-length": [2, "always", 100]
  }
}
