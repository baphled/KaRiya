// BEHAVIOR USAGE TEMPLATE
//
// THIS FILE IS A TEMPLATE - DO NOT IMPORT DIRECTLY
// Copy and adapt when adding table-based views to intents.
//
// CRITICAL: Use TableBehavior[T] instead of manual table.New()
// This eliminates boilerplate and ensures consistent behavior.
//
// See: internal/cli/behaviors/ for all available behaviors

package intents

import (
	"github.com/baphled/kariya/internal/cli/behaviors"
	"github.com/baphled/kariya/internal/cli/themes"
	tea "github.com/charmbracelet/bubbletea"
)

// -----------------------------------------------------------------------------
// STEP 1: Define Your Item Type
// -----------------------------------------------------------------------------

// ExampleItem is the data type displayed in the table.
type ExampleItem struct {
	ID          string
	Name        string
	Category    string
	Description string
	Count       int
}

// -----------------------------------------------------------------------------
// STEP 2: Define Column Configuration
// -----------------------------------------------------------------------------

// ExampleColumns defines the table columns.
var ExampleColumns = []behaviors.ColumnDef{
	{Title: "Name", Width: 25},
	{Title: "Category", Width: 15},
	{Title: "Count", Width: 10},
}

// -----------------------------------------------------------------------------
// STEP 3: Define Row Formatter
// -----------------------------------------------------------------------------

// ExampleRowFormatter formats an item as table row values.
func ExampleRowFormatter(item ExampleItem) []string {
	return []string{
		item.Name,
		item.Category,
		fmt.Sprintf("%d", item.Count),
	}
}

// -----------------------------------------------------------------------------
// STEP 4: Create TableBehavior in Intent
// -----------------------------------------------------------------------------

type ExampleIntent struct {
	*BaseIntent

	// Use TableBehavior instead of manual table.Model
	table *behaviors.TableBehavior[ExampleItem]

	// Other intent state
	items []ExampleItem
}

func NewExampleIntent(theme themes.Theme) *ExampleIntent {
	i := &ExampleIntent{
		BaseIntent: NewBaseIntent(),
	}

	// Create table behavior with fluent API
	i.table = behaviors.NewTableBehavior(theme, ExampleColumns, ExampleRowFormatter).
		PageSize(15).
		EmptyMessage("No items found").
		ShowPagination(true)

	return i
}

// -----------------------------------------------------------------------------
// STEP 5: Set Items and Handle Navigation
// -----------------------------------------------------------------------------

func (i *ExampleIntent) Init() tea.Cmd {
	// Load items (from repository, service, etc.)
	i.items = loadItems()
	i.table.SetItems(i.items)
	return nil
}

func (i *ExampleIntent) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	switch msg := msg.(type) {
	case tea.KeyMsg:
		keyStr := msg.String()

		// Let table handle navigation first
		if i.table.HandleNavigation(keyStr) {
			return i, nil
		}

		// Handle intent-specific keys
		switch keyStr {
		case "enter":
			if selected := i.table.SelectedItem(); selected != nil {
				return i, i.handleItemSelected(*selected)
			}
		case "d":
			if selected := i.table.SelectedItem(); selected != nil {
				return i, i.handleDelete(*selected)
			}
		case "f":
			// Apply filter
			i.table.SetFilter(func(item ExampleItem) bool {
				return item.Category == "important"
			})
		case "c":
			// Clear filter
			i.table.ClearFilter()
		case "s":
			// Sort by name
			i.table.SetSort(func(a, b ExampleItem) int {
				return strings.Compare(a.Name, b.Name)
			}, false)
		}
	}
	return i, nil
}

// -----------------------------------------------------------------------------
// STEP 6: Render Table in View
// -----------------------------------------------------------------------------

func (i *ExampleIntent) View() string {
	content := i.table.Render()

	// Add pagination info
	if i.table.ShowsPagination() {
		content += "\n" + i.table.PaginationInfo()
	}

	return components.NewStandardView().
		WithLogo(i.GetLogo()).
		WithContent(content).
		WithFooter("Enter: select | d: delete | f: filter | s: sort | Esc: back").
		Render(i.GetTerminalInfo())
}

// -----------------------------------------------------------------------------
// AVAILABLE BEHAVIORS REFERENCE
// -----------------------------------------------------------------------------

/*
TableBehavior[T] - Data binding, pagination, navigation for tables
    Methods:
    - SetItems(items []T)
    - SelectedItem() *T
    - SelectedIndex() int
    - HandleNavigation(key string) bool
    - SetFilter(predicate FilterPredicate[T])
    - ClearFilter()
    - SetSort(comparator SortComparator[T], reverse bool)
    - Render() string
    - PaginationInfo() string

CRUDBehavior[T] - Create/edit/delete operations with confirmation
    Methods:
    - StartCreate()
    - StartEdit(item T)
    - StartDelete(item T)
    - ConfirmDelete() bool
    - CancelOperation()
    - GetMode() CRUDMode
    - GetEditItem() *T

FilterMenuBehavior[T] - Sectioned filter menu with multi-select
    Methods:
    - AddSection(title string, options []MenuOption[T])
    - HandleKey(key string) bool
    - SelectedFilters() []T
    - Render() string

SortMenuBehavior[T] - Sort options menu
    Methods:
    - AddOption(title string, comparator SortComparator[T])
    - HandleKey(key string) bool
    - SelectedComparator() SortComparator[T]
    - Render() string
*/
