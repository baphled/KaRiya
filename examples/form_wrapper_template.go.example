// FORM WRAPPER TEMPLATE
//
// THIS FILE IS A TEMPLATE - DO NOT IMPORT DIRECTLY
// Copy and adapt when adding forms to intents.
//
// CRITICAL: Forms in intents MUST use wrapper models (not raw *huh.Form)
// Direct *huh.Form usage causes left-alignment issues because:
// - Form dimensions are captured at creation time and become stale
// - WindowSizeMsg handling is scattered and error-prone
// - Forms don't update properly on terminal resize
//
// See: docs/FORMS_GUIDE.md#form-alignment-and-the-wrapper-pattern

package models

import (
	"github.com/baphled/kariya/internal/cli/forms"
	tea "github.com/charmbracelet/bubbletea"
	"github.com/charmbracelet/huh"
)

// -----------------------------------------------------------------------------
// STEP 1: Define Form Data Structure
// -----------------------------------------------------------------------------

// ExampleFormData holds the form field values.
// This is bound to the huh form fields.
type ExampleFormData struct {
	Name            string
	Description     string
	Category        string
	Tags            []string
	SubmitConfirmed bool // Required for confirm button
}

// -----------------------------------------------------------------------------
// STEP 2: Create Form Wrapper Model
// -----------------------------------------------------------------------------

// ExampleForm wraps a huh form for the example use case.
// It handles WindowSizeMsg internally to prevent alignment issues.
type ExampleForm struct {
	*BaseStandardModel // Embed for standard model behavior

	formData *ExampleFormData
	form     *huh.Form
	width    int
	height   int
}

// NewExampleForm creates a new form wrapper.
func NewExampleForm() *ExampleForm {
	formData := &ExampleFormData{}

	m := &ExampleForm{
		BaseStandardModel: NewBaseStandardModel(),
		formData:          formData,
		width:             80, // Default width
		height:            24, // Default height
	}

	m.rebuildForm()
	return m
}

// rebuildForm creates a new form with current dimensions.
// Call this whenever dimensions change significantly.
func (m *ExampleForm) rebuildForm() {
	// Use forms package helpers for consistent theming
	m.form = forms.NewFormWithFixedConfirm(
		huh.NewGroup(
			forms.NewInput(forms.FieldConfig{
				Key:      "name",
				Title:    "Name",
				Validate: forms.Required,
			}).Value(&m.formData.Name),

			forms.NewTextArea(forms.FieldConfig{
				Key:   "description",
				Title: "Description",
			}).Value(&m.formData.Description),

			forms.NewSelect(forms.FieldConfig{
				Key:   "category",
				Title: "Category",
			}).Options(
				huh.NewOption("Option A", "a"),
				huh.NewOption("Option B", "b"),
				huh.NewOption("Option C", "c"),
			).Value(&m.formData.Category),

			forms.NewMultiSelect(forms.FieldConfig{
				Key:   "tags",
				Title: "Tags",
			}).Options(
				huh.NewOption("Tag 1", "tag1"),
				huh.NewOption("Tag 2", "tag2"),
				huh.NewOption("Tag 3", "tag3"),
			).Value(&m.formData.Tags),
		),
		&m.formData.SubmitConfirmed,
		m.width-4,
		forms.DefaultFormHeight(m.height),
	)
}

// -----------------------------------------------------------------------------
// STEP 3: Implement tea.Model Interface
// -----------------------------------------------------------------------------

// Init initializes the form.
func (m *ExampleForm) Init() tea.Cmd {
	return m.form.Init()
}

// Update handles messages - CRITICAL: Handle WindowSizeMsg here!
func (m *ExampleForm) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	switch msg := msg.(type) {
	case tea.WindowSizeMsg:
		// CRITICAL: Update dimensions internally
		m.width = msg.Width
		m.height = msg.Height
		m.form = m.form.WithHeight(forms.DefaultFormHeight(m.height)).WithWidth(m.width - 4)
		return m, nil

	case tea.KeyMsg:
		// Handle escape BEFORE delegating to form
		// This allows parent intent to handle back navigation
		if msg.String() == "esc" {
			return m, nil // Parent checks for escape via HandleGlobalKeys
		}

		// Handle Ctrl+S for quick submit
		if msg.String() == "ctrl+s" {
			m.formData.SubmitConfirmed = true
			return m, m.submit()
		}
	}

	// Delegate to huh form
	form, cmd := m.form.Update(msg)
	if f, ok := form.(*huh.Form); ok {
		m.form = f
	}

	// Check for form completion (Submit button pressed)
	if m.form.State == huh.StateCompleted {
		return m, m.submit()
	}

	return m, cmd
}

// View renders the form.
func (m *ExampleForm) View() string {
	return m.form.View()
}

// -----------------------------------------------------------------------------
// STEP 4: Add Submission and Data Access Methods
// -----------------------------------------------------------------------------

// submit creates a submission command.
func (m *ExampleForm) submit() tea.Cmd {
	return func() tea.Msg {
		return FormSubmittedMsg{
			Data: m.formData,
		}
	}
}

// FormSubmittedMsg is sent when the form is submitted.
type FormSubmittedMsg struct {
	Data *ExampleFormData
}

// GetData returns the current form data.
func (m *ExampleForm) GetData() *ExampleFormData {
	return m.formData
}

// SetData sets the form data (for editing existing items).
func (m *ExampleForm) SetData(data *ExampleFormData) {
	m.formData = data
	m.rebuildForm()
}

// IsSubmitted returns whether the form was submitted.
func (m *ExampleForm) IsSubmitted() bool {
	return m.formData.SubmitConfirmed
}

// -----------------------------------------------------------------------------
// STEP 5: Usage in Intent
// -----------------------------------------------------------------------------

/*
// In your intent:

type MyIntent struct {
    *BaseIntent
    
    // CORRECT: Use form wrapper
    exampleForm *ExampleForm
    
    // WRONG: Direct huh.Form causes alignment issues
    // form *huh.Form
}

func (i *MyIntent) handleShowForm() tea.Cmd {
    i.exampleForm = NewExampleForm()
    i.state = StateShowingForm
    return i.exampleForm.Init()
}

func (i *MyIntent) updateForm(msg tea.Msg) tea.Cmd {
    model, cmd := i.exampleForm.Update(msg)
    i.exampleForm = model.(*ExampleForm)
    
    // Check for submission
    if submitted, ok := cmd().(FormSubmittedMsg); ok {
        i.handleFormSubmission(submitted.Data)
        return nil
    }
    
    return cmd
}

func (i *MyIntent) viewForm() string {
    return i.exampleForm.View()
}
*/
