// Package {feature} contains screens for the {Feature} intent.
package {feature}

import (
	"github.com/baphled/kariya/internal/cli/behaviors"
	"github.com/baphled/kariya/internal/cli/screens"
	"github.com/baphled/kariya/internal/cli/screens/base"
	"github.com/baphled/kariya/internal/cli/uikit/layout"
	"github.com/baphled/kariya/internal/cli/uikit/primitives"
	"github.com/baphled/kariya/internal/domain/career"
	"github.com/charmbracelet/bubbles/table"
	tea "github.com/charmbracelet/bubbletea"
)

// ListScreen displays a list of items using TableBehavior.
//
// The {Entity} type is expected to have the following fields used by formatRow:
//   - Name      string    - Display name for the entity
//   - Category  string    - Category or type classification
//   - CreatedAt time.Time - Creation timestamp
//
// Customize the formatRow method and table columns to match your entity structure.
type ListScreen struct {
	*base.BaseScreen

	items []*career.{Entity}
	table *behaviors.TableBehavior[*career.{Entity}]
}

// NewListScreen creates a new list screen.
func NewListScreen(items []*career.{Entity}) *ListScreen {
	return &ListScreen{
		BaseScreen: base.NewBaseScreen(),
		items:      items,
	}
}

// Init initializes the screen.
func (s *ListScreen) Init() tea.Cmd {
	// Create table with columns
	columns := []table.Column{
		{Title: "Name", Width: 30},
		{Title: "Category", Width: 20},
		{Title: "Created", Width: 15},
	}

	// Create table behavior
	s.table = behaviors.NewTableBehavior(
		s.Theme(),
		columns,
		s.formatRow,
	).WithPageSize(20).
		WithEmptyMessage("No items found")

	// Set items
	s.table.SetItems(s.items)

	return nil
}

// Update handles messages.
func (s *ListScreen) Update(msg tea.Msg) (tea.Cmd, screens.ScreenResult) {
	switch msg := msg.(type) {
	case tea.KeyMsg:
		switch msg.String() {
		case "esc":
			return nil, screens.NewCancelResult("")
		case "enter":
			if item := s.table.GetSelectedItem(); item != nil {
				return nil, screens.NewNavigateResult(map[string]interface{}{
					"action": "view",
					"item":   item,
				})
			}
		case "a":
			return nil, screens.NewNavigateResult(map[string]interface{}{
				"action": "add",
			})
		case "e":
			if item := s.table.GetSelectedItem(); item != nil {
				return nil, screens.NewNavigateResult(map[string]interface{}{
					"action": "edit",
					"item":   item,
				})
			}
		case "d":
			if item := s.table.GetSelectedItem(); item != nil {
				return nil, screens.NewNavigateResult(map[string]interface{}{
					"action": "delete",
					"item":   item,
				})
			}
		}
	}

	// Delegate to table
	cmd := s.table.Update(msg)
	return cmd, nil
}

// View renders the screen.
func (s *ListScreen) View() string {
	theme := s.Theme()

	// Create layout
	layout := layout.NewScreenLayout(theme).
		WithLogo(s.Logo(), s.LogoSpacing()).
		WithBreadcrumbs([]string{"{Feature}", "List"}).
		WithContent(s.table.Render()).
		WithHelp(s.getHelp())

	return layout.Render()
}

// formatRow formats a table row.
func (s *ListScreen) formatRow(item *career.{Entity}) table.Row {
	return table.Row{
		item.Name,
		item.Category,
		item.CreatedAt.Format("2006-01-02"),
	}
}

// getHelp returns keyboard shortcuts.
func (s *ListScreen) getHelp() string {
	theme := s.Theme()
	return primitives.CombineThemedFooters(
		primitives.ThemedCustomFooter(theme,
			primitives.NavigateBadge(theme),
			primitives.HelpKeyBadge("Enter", "View", theme),
			primitives.AddBadge(theme),
			primitives.EditBadge(theme),
			primitives.DeleteBadge(theme),
			primitives.BackBadge(theme),
		),
		primitives.ThemedGlobalBadges(theme),
	)
}
